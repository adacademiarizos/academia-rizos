// ============= BUSINESS SCHEDULE =============

model BusinessHours {
  id        String  @id @default(cuid())
  dayOfWeek Int // 0=Sun, 1=Mon … 6=Sat
  isOpen    Boolean @default(true)
  openTime  String // "HH:MM" e.g. "09:00"
  closeTime String // "HH:MM" e.g. "18:00"

  @@unique([dayOfWeek])
}

model BusinessOffDay {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())

  @@unique([date])
}

// ============= TESTIMONIALS =============

model Testimonial {
  id        String          @id @default(cuid())
  name      String
  role      String          @default("Clienta")
  quote     String
  type      TestimonialType @default(SALON)
  stars     Int             @default(5)
  avatarUrl String?
  isActive  Boolean         @default(true)
  order     Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([order])
  @@index([type, order])
}

// ============= ANALYTICS =============

model PageView {
  id        String  @id @default(cuid())
  path      String
  referrer  String?
  sessionId String
  userId    String?

  // UTM parameters
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  // Device & browser info
  deviceType String? // "mobile" | "desktop" | "tablet"
  browser    String?
  os         String?

  // Geographic info (from Vercel headers)
  country String?
  city    String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([path])
  @@index([utmSource])
  @@index([utmCampaign])
  @@index([userId])
}

model ConversionEvent {
  id        String  @id @default(cuid())
  type      String // "BOOKING" | "COURSE_PURCHASE" | "REGISTRATION"
  paymentId String?  @unique
  sessionId String
  userId    String?
  referrer  String?

  // UTM attribution
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  // Revenue data
  amountCents Int?
  currency    String? @default("EUR")

  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([sessionId])
  @@index([utmSource])
  @@index([utmCampaign])
}
